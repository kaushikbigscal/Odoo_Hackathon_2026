<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_maintenance_approved" model="mail.template">
            <field name="name">AssetFlow: Maintenance Request Approved</field>
            <field name="model_id" ref="model_assetflow_maintenance_request"/>
            <field name="subject">Maintenance Request Approved: {{ object.name }}</field>
            <field name="email_to">{{ object.requester_id.user_id.email }}</field>
            <field name="body_html" type="html">
                <p>Your maintenance request has been approved.</p>
                <p><strong>Asset:</strong> {{ object.asset_id.name }}</p>
                <p><strong>Issue:</strong> {{ object.description }}</p>
            </field>
        </record>
    </data>
</odoo>
