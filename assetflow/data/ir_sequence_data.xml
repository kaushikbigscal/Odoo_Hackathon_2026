<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_assetflow_asset" model="ir.sequence">
            <field name="name">AssetFlow Asset</field>
            <field name="code">assetflow.asset</field>
            <field name="prefix">AF-%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_assetflow_allocation" model="ir.sequence">
            <field name="name">AssetFlow Allocation</field>
            <field name="code">assetflow.allocation</field>
            <field name="prefix">AL-%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_assetflow_booking" model="ir.sequence">
            <field name="name">AssetFlow Booking</field>
            <field name="code">assetflow.booking</field>
            <field name="prefix">BK-%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_assetflow_transfer" model="ir.sequence">
            <field name="name">AssetFlow Transfer</field>
            <field name="code">assetflow.transfer</field>
            <field name="prefix">TR-%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
