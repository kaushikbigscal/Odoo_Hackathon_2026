<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetflow_allocation_list" model="ir.ui.view">
        <field name="name">assetflow.allocation.list</field>
        <field name="model">assetflow.allocation</field>
        <field name="arch" type="xml">
            <list string="Allocations" decoration-danger="is_overdue">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="expected_return_date"/>
                <field name="is_overdue" invisible="1"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_assetflow_allocation_form" model="ir.ui.view">
        <field name="name">assetflow.allocation.form</field>
        <field name="model">assetflow.allocation</field>
        <field name="arch" type="xml">
            <form string="Asset Allocation">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'requested'"/>
                    <button name="action_activate" type="object" string="Activate" class="btn-success"
                            invisible="state != 'approved'"/>
                    <button name="action_return" type="object" string="Mark Returned"
                            invisible="state not in ('active','return_requested')"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger"
                            invisible="state != 'requested'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,approved,active,returned"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="asset_id"/>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="expected_return_date"/>
                            <field name="actual_return_date"/>
                            <field name="condition_checkin"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_assetflow_allocation" model="ir.actions.act_window">
        <field name="name">Allocations</field>
        <field name="res_model">assetflow.allocation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
