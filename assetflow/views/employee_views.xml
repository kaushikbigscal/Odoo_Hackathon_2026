<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetflow_employee_list" model="ir.ui.view">
        <field name="name">assetflow.employee.list</field>
        <field name="model">assetflow.employee</field>
        <field name="arch" type="xml">
            <list string="Employees">
                <field name="name"/>
                <field name="department_id"/>
                <field name="role" widget="badge"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_assetflow_employee_form" model="ir.ui.view">
        <field name="name">assetflow.employee.form</field>
        <field name="model">assetflow.employee</field>
        <field name="arch" type="xml">
            <form string="Employee">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assets" type="object" class="oe_stat_button" icon="fa-cube">
                            <field name="allocation_count" widget="statinfo" string="Assets"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Employee Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="role"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_assetflow_employee" model="ir.actions.act_window">
        <field name="name">Employee Directory</field>
        <field name="res_model">assetflow.employee</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
