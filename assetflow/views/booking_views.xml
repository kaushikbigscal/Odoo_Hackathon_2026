<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetflow_booking_list" model="ir.ui.view">
        <field name="name">assetflow.booking.list</field>
        <field name="model">assetflow.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_assetflow_booking_form" model="ir.ui.view">
        <field name="name">assetflow.booking.form</field>
        <field name="model">assetflow.booking</field>
        <field name="arch" type="xml">
            <form string="Resource Booking">
                <header>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-danger"
                            invisible="state in ('completed','cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="asset_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_assetflow_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">assetflow.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
