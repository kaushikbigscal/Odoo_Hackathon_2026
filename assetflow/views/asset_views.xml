<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetflow_asset_list" model="ir.ui.view">
        <field name="name">assetflow.asset.list</field>
        <field name="model">assetflow.asset</field>
        <field name="arch" type="xml">
            <list string="Assets" decoration-muted="state in ('retired','disposed')"
                  decoration-danger="state == 'lost'">
                <field name="asset_tag"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="serial_number"/>
                <field name="department_id"/>
                <field name="location"/>
                <field name="condition"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_assetflow_asset_form" model="ir.ui.view">
        <field name="name">assetflow.asset.form</field>
        <field name="model">assetflow.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,allocated,under_maintenance"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_history" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="allocation_count" widget="statinfo" string="Allocations"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="asset_tag" readonly="1"/></h1>
                        <h2><field name="name" placeholder="Asset Name"/></h2>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="category_id"/>
                            <field name="serial_number"/>
                            <field name="acquisition_date"/>
                            <field name="acquisition_cost"/>
                        </group>
                        <group string="Location &amp; Status">
                            <field name="location"/>
                            <field name="department_id"/>
                            <field name="condition"/>
                            <field name="is_bookable"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allocations">
                            <field name="allocation_ids"/>
                        </page>
                        <page string="Bookings">
                            <field name="booking_ids"/>
                        </page>
                        <page string="Maintenance">
                            <field name="maintenance_request_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_assetflow_asset_search" model="ir.ui.view">
        <field name="name">assetflow.asset.search</field>
        <field name="model">assetflow.asset</field>
        <field name="arch" type="xml">
            <search string="Search Assets">
                <field name="name"/>
                <field name="asset_tag"/>
                <field name="serial_number"/>
                <field name="location"/>
                <filter string="Available" name="available" domain="[('state','=','available')]"/>
                <filter string="Allocated" name="allocated" domain="[('state','=','allocated')]"/>
                <filter string="Under Maintenance" name="maintenance" domain="[('state','=','under_maintenance')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Category" name="group_category" context="{'group_by':'category_id'}"/>
                    <filter string="Department" name="group_dept" context="{'group_by':'department_id'}"/>
                    <filter string="Location" name="group_location" context="{'group_by':'location'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_assetflow_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">assetflow.asset</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_assetflow_asset_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first asset</p>
        </field>
    </record>
</odoo>
