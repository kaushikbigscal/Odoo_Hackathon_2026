<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetflow_audit_cycle_list" model="ir.ui.view">
        <field name="name">assetflow.audit.cycle.list</field>
        <field name="model">assetflow.audit.cycle</field>
        <field name="arch" type="xml">
            <list string="Audit Cycles">
                <field name="name"/>
                <field name="department_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="discrepancy_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_assetflow_audit_cycle_form" model="ir.ui.view">
        <field name="name">assetflow.audit.cycle.form</field>
        <field name="model">assetflow.audit.cycle</field>
        <field name="arch" type="xml">
            <form string="Audit Cycle">
                <header>
                    <button name="action_generate_lines" type="object" string="Start Audit" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close Audit" class="btn-success"
                            invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Audit Cycle Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="department_id"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="auditor_ids" widget="many2many_tags"/>
                            <field name="discrepancy_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Audit Lines">
                            <field name="line_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_assetflow_audit_cycle" model="ir.actions.act_window">
        <field name="name">Audit Cycles</field>
        <field name="res_model">assetflow.audit.cycle</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
