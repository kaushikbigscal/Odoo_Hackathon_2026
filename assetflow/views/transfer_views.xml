<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assetflow_transfer_list" model="ir.ui.view">
        <field name="name">assetflow.transfer.list</field>
        <field name="model">assetflow.transfer</field>
        <field name="arch" type="xml">
            <list string="Transfers">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="from_employee_id"/>
                <field name="to_employee_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_assetflow_transfer_form" model="ir.ui.view">
        <field name="name">assetflow.transfer.form</field>
        <field name="model">assetflow.transfer</field>
        <field name="arch" type="xml">
            <form string="Asset Transfer">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'requested'"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-success"
                            invisible="state != 'approved'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger"
                            invisible="state != 'requested'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="asset_id"/>
                            <field name="from_employee_id"/>
                            <field name="to_employee_id"/>
                        </group>
                        <group>
                            <field name="reason"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_assetflow_transfer" model="ir.actions.act_window">
        <field name="name">Transfers</field>
        <field name="res_model">assetflow.transfer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
