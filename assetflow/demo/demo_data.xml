<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="assetflow_department_ops" model="assetflow.department">
        <field name="name">Operations</field>
        <field name="code">OPS</field>
    </record>
    <record id="assetflow_department_hr" model="assetflow.department">
        <field name="name">Human Resources</field>
        <field name="code">HR</field>
    </record>

    <record id="assetflow_category_electronics" model="assetflow.category">
        <field name="name">Electronics</field>
        <field name="warranty_period_months">24</field>
    </record>
    <record id="assetflow_category_furniture" model="assetflow.category">
        <field name="name">Furniture</field>
        <field name="warranty_period_months">60</field>
    </record>
    <record id="assetflow_category_vehicles" model="assetflow.category">
        <field name="name">Vehicles</field>
        <field name="warranty_period_months">36</field>
    </record>

    <record id="assetflow_asset_laptop_1" model="assetflow.asset">
        <field name="name">Dell XPS 15</field>
        <field name="category_id" ref="assetflow_category_electronics"/>
        <field name="serial_number">SN-DELL-001</field>
        <field name="location">Office - Floor 2</field>
        <field name="department_id" ref="assetflow_department_ops"/>
        <field name="acquisition_cost">1200.00</field>
        <field name="state">available</field>
    </record>
    <record id="assetflow_asset_laptop_2" model="assetflow.asset">
        <field name="name">MacBook Pro 14</field>
        <field name="category_id" ref="assetflow_category_electronics"/>
        <field name="serial_number">SN-APL-001</field>
        <field name="location">Office - Floor 2</field>
        <field name="department_id" ref="assetflow_department_hr"/>
        <field name="acquisition_cost">2000.00</field>
        <field name="is_bookable" eval="True"/>
        <field name="state">available</field>
    </record>
    <record id="assetflow_asset_desk_1" model="assetflow.asset">
        <field name="name">Standing Desk A1</field>
        <field name="category_id" ref="assetflow_category_furniture"/>
        <field name="serial_number">SN-DESK-001</field>
        <field name="location">Office - Floor 1</field>
        <field name="acquisition_cost">450.00</field>
        <field name="state">available</field>
    </record>
</odoo>
