<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_asset_utilization" model="ir.actions.report">
        <field name="name">Asset Utilization Report</field>
        <field name="model">assetflow.asset</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">assetflow.report_asset_utilization</field>
        <field name="report_file">assetflow.report_asset_utilization</field>
        <field name="binding_model_id" ref="model_assetflow_asset"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_asset_utilization">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Asset Utilization Report</h2>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Asset Tag</th>
                                    <th>Name</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Location</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><t t-out="doc.asset_tag"/></td>
                                    <td><t t-out="doc.name"/></td>
                                    <td><t t-out="doc.category_id.name"/></td>
                                    <td><t t-out="doc.state"/></td>
                                    <td><t t-out="doc.location"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
