<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="assetflow_rule_department" model="ir.rule">
        <field name="name">AssetFlow: Department Head sees own department assets</field>
        <field name="model_id" ref="model_assetflow_asset"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_assetflow_department_head'))]"/>
    </record>

    <record id="assetflow_rule_manager_all" model="ir.rule">
        <field name="name">AssetFlow: Manager sees all assets</field>
        <field name="model_id" ref="model_assetflow_asset"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_assetflow_asset_manager'))]"/>
    </record>
</odoo>
