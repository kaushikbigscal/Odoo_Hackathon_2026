<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dayflow_attendance_day_list" model="ir.ui.view">
        <field name="name">dayflow.attendance.day.list</field>
        <field name="model">dayflow.attendance.day</field>
        <field name="arch" type="xml">
            <list string="Attendance Status" default_order="date desc">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'present'"
                       decoration-warning="status == 'half_day'"
                       decoration-danger="status == 'absent'"
                       decoration-info="status == 'leave'"/>
                <field name="worked_hours"/>
                <field name="expected_hours"/>
            </list>
        </field>
    </record>

    <record id="view_dayflow_attendance_day_calendar" model="ir.ui.view">
        <field name="name">dayflow.attendance.day.calendar</field>
        <field name="model">dayflow.attendance.day</field>
        <field name="arch" type="xml">
            <calendar string="Attendance Status" date_start="date" mode="month" color="status">
                <field name="employee_id"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <record id="view_dayflow_attendance_day_search" model="ir.ui.view">
        <field name="name">dayflow.attendance.day.search</field>
        <field name="model">dayflow.attendance.day</field>
        <field name="arch" type="xml">
            <search string="Attendance Status">
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter string="Present" name="filter_present" domain="[('status', '=', 'present')]"/>
                <filter string="Half-day" name="filter_half_day" domain="[('status', '=', 'half_day')]"/>
                <filter string="Absent" name="filter_absent" domain="[('status', '=', 'absent')]"/>
                <filter string="Leave" name="filter_leave" domain="[('status', '=', 'leave')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="groupby_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="groupby_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="groupby_status" context="{'group_by': 'status'}"/>
                    <filter string="Date" name="groupby_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dayflow_attendance_day_my" model="ir.actions.act_window">
        <field name="name">My Attendance Status</field>
        <field name="res_model">dayflow.attendance.day</field>
        <field name="view_mode">calendar,list</field>
        <field name="search_view_id" ref="view_dayflow_attendance_day_search"/>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
    </record>

    <record id="action_dayflow_attendance_day_all" model="ir.actions.act_window">
        <field name="name">Attendance Status (All)</field>
        <field name="res_model">dayflow.attendance.day</field>
        <field name="view_mode">list,calendar</field>
        <field name="search_view_id" ref="view_dayflow_attendance_day_search"/>
        <field name="context">{'search_default_groupby_employee': 1}</field>
    </record>

</odoo>
