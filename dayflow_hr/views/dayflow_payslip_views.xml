<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dayflow_payslip_list" model="ir.ui.view">
        <field name="name">dayflow.payslip.list</field>
        <field name="model">dayflow.payslip</field>
        <field name="arch" type="xml">
            <list string="Payslips">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="basic_wage"/>
                <field name="gross_pay"/>
                <field name="total_deductions"/>
                <field name="net_pay"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-info="state == 'confirmed'"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_dayflow_payslip_form" model="ir.ui.view">
        <field name="name">dayflow.payslip.form</field>
        <field name="model">dayflow.payslip</field>
        <field name="arch" type="xml">
            <form string="Payslip">
                <header>
                    <button name="action_compute" type="object" string="Compute" class="btn-primary"
                            invisible="state not in ('draft', 'computed')"/>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'computed'"/>
                    <button name="action_mark_paid" type="object" string="Mark as Paid" class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('computed', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,confirmed,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Attendance">
                        <field name="expected_days" readonly="1"/>
                        <field name="absent_days" readonly="1"/>
                        <field name="worked_days" readonly="1"/>
                    </group>
                    <group string="Earnings &amp; Deductions">
                        <field name="basic_wage" readonly="1"/>
                        <field name="line_ids" readonly="1" nolabel="1" colspan="2">
                            <list>
                                <field name="name"/>
                                <field name="rule_type"/>
                                <field name="amount"/>
                            </list>
                        </field>
                    </group>
                    <group>
                        <group/>
                        <group>
                            <field name="gross_pay" readonly="1"/>
                            <field name="total_deductions" readonly="1"/>
                            <field name="net_pay" readonly="1" class="fw-bold"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dayflow_payslip_search" model="ir.ui.view">
        <field name="name">dayflow.payslip.search</field>
        <field name="model">dayflow.payslip</field>
        <field name="arch" type="xml">
            <search string="Payslips">
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Computed" name="filter_computed" domain="[('state', '=', 'computed')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Paid" name="filter_paid" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="groupby_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="groupby_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Period" name="groupby_date_from" context="{'group_by': 'date_from'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dayflow_payslip_my" model="ir.actions.act_window">
        <field name="name">My Payslips</field>
        <field name="res_model">dayflow.payslip</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dayflow_payslip_search"/>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
    </record>

    <record id="action_dayflow_payslip_all" model="ir.actions.act_window">
        <field name="name">Payslips</field>
        <field name="res_model">dayflow.payslip</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dayflow_payslip_search"/>
        <field name="context">{'search_default_groupby_employee': 1}</field>
    </record>

    <record id="view_dayflow_salary_rule_list" model="ir.ui.view">
        <field name="name">dayflow.salary.rule.list</field>
        <field name="model">dayflow.salary.rule</field>
        <field name="arch" type="xml">
            <list string="Salary Rules" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="amount_type"/>
                <field name="amount_value"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_dayflow_salary_rule_form" model="ir.ui.view">
        <field name="name">dayflow.salary.rule.form</field>
        <field name="model">dayflow.salary.rule</field>
        <field name="arch" type="xml">
            <form string="Salary Rule">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="rule_type"/>
                        <field name="amount_type"/>
                        <field name="amount_value"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dayflow_salary_rule" model="ir.actions.act_window">
        <field name="name">Salary Rules</field>
        <field name="res_model">dayflow.salary.rule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
