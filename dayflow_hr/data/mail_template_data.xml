<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_email_verification" model="mail.template">
            <field name="name">Dayflow HR: Verify your email</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Verify your email to finish setting up Dayflow</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
                <p>Hi <t t-out="object.name or ''"/>,</p>
                <p>Thanks for signing up for Dayflow. Please confirm your email address to
                    activate your account:</p>
                <p>
                    <a t-attf-href="{{ object.get_base_url() }}/dayflow/verify/{{ object.dayflow_verification_token }}"
                       style="padding: 8px 16px; background-color: #3b6ef6; color: #fff; border-radius: 4px; text-decoration: none;">
                        Verify my email
                    </a>
                </p>
                <p>If you did not request this account, you can ignore this email.</p>
            </field>
        </record>

        <record id="mail_template_role_approved" model="mail.template">
            <field name="name">Dayflow HR: HR role approved</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Your Dayflow HR access request was approved</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
                <p>Hi <t t-out="object.name or ''"/>,</p>
                <p>Your request for HR / Admin access on Dayflow has been approved. You now have
                    access to the HR dashboard, employee records and approvals.</p>
            </field>
        </record>

        <record id="mail_template_role_rejected" model="mail.template">
            <field name="name">Dayflow HR: HR role rejected</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Your Dayflow HR access request was not approved</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
                <p>Hi <t t-out="object.name or ''"/>,</p>
                <p>Your request for HR / Admin access on Dayflow was not approved. You still have
                    full access as an Employee. Contact your administrator if you believe this is
                    a mistake.</p>
            </field>
        </record>

        <record id="mail_template_leave_submitted" model="mail.template">
            <field name="name">Dayflow HR: Leave request submitted</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="subject">New leave request from {{ object.employee_id.name }}</field>
            <field name="body_html" type="html">
                <p><t t-out="object.employee_id.name or ''"/> requested
                    <strong><t t-out="object.holiday_status_id.name or ''"/></strong>
                    from <t t-out="object.date_from and object.date_from.date()"/>
                    to <t t-out="object.date_to and object.date_to.date()"/>
                    (<t t-out="object.number_of_days"/> day(s)).</p>
                <p t-if="object.notes">Reason: <t t-out="object.notes"/></p>
                <p>Please review it from Dayflow's Leave Approvals.</p>
            </field>
        </record>

        <record id="mail_template_leave_approved" model="mail.template">
            <field name="name">Dayflow HR: Leave request approved</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="subject">Your leave request has been approved</field>
            <field name="body_html" type="html">
                <p>Hi <t t-out="object.employee_id.name or ''"/>,</p>
                <p>Your <strong><t t-out="object.holiday_status_id.name or ''"/></strong> request from
                    <t t-out="object.date_from and object.date_from.date()"/> to
                    <t t-out="object.date_to and object.date_to.date()"/> has been approved.</p>
            </field>
        </record>

        <record id="mail_template_leave_refused" model="mail.template">
            <field name="name">Dayflow HR: Leave request refused</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="subject">Your leave request has been refused</field>
            <field name="body_html" type="html">
                <p>Hi <t t-out="object.employee_id.name or ''"/>,</p>
                <p>Your <strong><t t-out="object.holiday_status_id.name or ''"/></strong> request from
                    <t t-out="object.date_from and object.date_from.date()"/> to
                    <t t-out="object.date_to and object.date_to.date()"/> has been refused.
                    Check the request's chatter for any comments from your approver.</p>
            </field>
        </record>

    </data>
</odoo>
